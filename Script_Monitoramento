#!/usr/bin/env python3
import re
import csv
import time
import os
import logging
import threading
import hashlib
from datetime import datetime
from watchdog.observers import Observer
from watchdog.events import FileSystemEventHandler

# Configurações
class Config:
    LOG_FILES = {
        'auth': '/var/log/auth.log',
        'sys': '/var/log/syslog',
        'bash': os.path.expanduser('~/.bash_history')
    }
    MONITOR_FILES = ['/etc/passwd', '/etc/hosts']
    OUTPUT_CSV = 'monitoramento_logs.csv'
    FAIL_LOGIN_PATTERN = re.compile(r'Failed password for .* from (\d+\.\d+\.\d+\.\d+)')
    MODIFICATION_KEYWORDS = ['modified', 'changed', 'updated']
    CHECK_INTERVAL = 1  # segundos

# Configuração de logging
def setup_logging():
    logging.basicConfig(
        level=logging.INFO,
        format='%(asctime)s - %(levelname)s - %(message)s',
        handlers=[
            logging.FileHandler('monitor_errors.log'),
            logging.StreamHandler()
        ]
    )

# Verificação de arquivos e permissões
def check_files_and_permissions():
    for file_type, file_path in Config.LOG_FILES.items():
        if not os.path.exists(file_path):
            logging.warning(f"Arquivo {file_type} não encontrado em {file_path}")
        elif not os.access(file_path, os.R_OK):
            logging.error(f"Sem permissão para ler {file_path}")

    for file_path in Config.MONITOR_FILES:
        if not os.path.exists(file_path):
            logging.warning(f"Arquivo para monitoramento não encontrado: {file_path}")

# Função para registrar eventos
def log_event(evento):
    file_exists = os.path.isfile(Config.OUTPUT_CSV)
    try:
        with open(Config.OUTPUT_CSV, 'a', newline='') as csvfile:
            fieldnames = ['timestamp', 'tipo', 'detalhes', 'origem', 'hash']
            writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
            if not file_exists:
                writer.writeheader()
            writer.writerow(evento)
        logging.info(f"Evento registrado: {evento['tipo']} - {evento['origem']}")
    except Exception as e:
        logging.error(f"Erro ao escrever no CSV: {e}")

# Monitoramento de logs com tratamento de rotatividade
def tail_log(file_path, pattern=None, tipo=''):
    last_position = 0
    while True:
        try:
            if not os.path.exists(file_path):
                logging.warning(f"Arquivo {file_path} não encontrado. Tentando novamente...")
                time.sleep(5)
                continue

            current_size = os.path.getsize(file_path)
            if current_size < last_position:  # Arquivo foi rotacionado
                last_position = 0

            with open(file_path, 'r') as f:
                f.seek(last_position)
                while True:
                    line = f.readline()
                    if not line:
                        break
                    last_position = f.tell()
                    
                    if pattern and pattern.search(line):
                        evento = {
                            'timestamp': datetime.now().isoformat(),
                            'tipo': tipo,
                            'detalhes': line.strip(),
                            'origem': file_path,
                            'hash': ''
                        }
                        log_event(evento)
                time.sleep(Config.CHECK_INTERVAL)
        except IOError as e:
            logging.error(f"Erro temporário ao ler {file_path}: {e}")
            time.sleep(5)
        except Exception as e:
            logging.error(f"Erro crítico lendo {file_path}: {e}")
            time.sleep(10)

# Monitoramento do histórico do bash
def monitor_bash_history():
    last_size = os.path.getsize(Config.LOG_FILES['bash']) if os.path.exists(Config.LOG_FILES['bash']) else 0
    
    while True:
        try:
            if not os.path.exists(Config.LOG_FILES['bash']):
                time.sleep(5)
                continue

            current_size = os.path.getsize(Config.LOG_FILES['bash'])
            if current_size > last_size:
                with open(Config.LOG_FILES['bash'], 'r') as f:
                    f.seek(last_size)
                    new_commands = f.read().strip()
                    for cmd in new_commands.split('\n'):
                        if cmd.strip():
                            evento = {
                                'timestamp': datetime.now().isoformat(),
                                'tipo': 'Comando Executado',
                                'detalhes': cmd.strip(),
                                'origem': Config.LOG_FILES['bash'],
                                'hash': ''
                            }
                            log_event(evento)
                last_size = current_size
            elif current_size < last_size:  # Arquivo foi truncado ou rotacionado
                last_size = 0
                
            time.sleep(Config.CHECK_INTERVAL)
        except Exception as e:
            logging.error(f"Erro monitorando bash_history: {e}")
            time.sleep(5)

# Handler para monitoramento de arquivos
class FileChangeHandler(FileSystemEventHandler):
    def __init__(self):
        self.last_modified = {}
        self.last_hashes = {}
        
    def calculate_hash(self, file_path):
        try:
            hasher = hashlib.sha256()
            with open(file_path, 'rb') as f:
                buf = f.read()
                hasher.update(buf)
            return hasher.hexdigest()
        except Exception as e:
            logging.error(f"Erro ao calcular hash de {file_path}: {e}")
            return None
            
    def on_modified(self, event):
        if event.src_path in Config.MONITOR_FILES:
            current_time = time.time()
            
            # Prevenir múltiplos eventos rápidos
            if event.src_path in self.last_modified:
                if current_time - self.last_modified[event.src_path] < 2:
                    return
            
            # Calcular hash para verificar mudança real
            current_hash = self.calculate_hash(event.src_path)
            if current_hash is None:
                return
                
            if event.src_path in self.last_hashes and current_hash == self.last_hashes[event.src_path]:
                return  # Nenhuma mudança real no conteúdo
                
            self.last_modified[event.src_path] = current_time
            self.last_hashes[event.src_path] = current_hash
            
            evento = {
                'timestamp': datetime.now().isoformat(),
                'tipo': 'Alteração Arquivo',
                'detalhes': f'Arquivo modificado: {event.src_path}',
                'origem': event.src_path,
                'hash': current_hash
            }
            log_event(evento)

# Gerenciador principal
class MonitorManager:
    def __init__(self):
        self.threads = []
        self.observer = None
        
    def start_monitoring(self):
        check_files_and_permissions()
        
        # Iniciar threads para monitorar logs
        self.threads.append(threading.Thread(
            target=tail_log,
            args=(Config.LOG_FILES['auth'], Config.FAIL_LOGIN_PATTERN, 'Falha Login'),
            daemon=True
        ))
        
        self.threads.append(threading.Thread(
            target=tail_log,
            args=(Config.LOG_FILES['sys'], None, 'Log Sistema'),
            daemon=True
        ))
        
        self.threads.append(threading.Thread(
            target=monitor_bash_history,
            daemon=True
        ))
        
        # Configurar watchdog para monitorar arquivos
        self.observer = Observer()
        handler = FileChangeHandler()
        for file_path in Config.MONITOR_FILES:
            directory = os.path.dirname(file_path)
            if os.path.exists(directory):
                self.observer.schedule(handler, path=directory, recursive=False)
            else:
                logging.warning(f"Diretório não encontrado: {directory}")
        
        # Iniciar tudo
        for t in self.threads:
            t.start()
        
        if self.observer:
            self.observer.start()
        
        logging.info("Monitoramento iniciado com sucesso")
        
    def stop_monitoring(self):
        if self.observer:
            self.observer.stop()
            self.observer.join()
        logging.info("Monitoramento encerrado")

if __name__ == "__main__":
    setup_logging()
    
    manager = MonitorManager()
    manager.start_monitoring()
    
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        logging.info("Recebido sinal de interrupção, encerrando...")
    finally:
        manager.stop_monitoring()
